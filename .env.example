DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ookaro_db
DB_PORT=3306

# The exact same Firebase service account JSON ookaro-api's own .env.local holds -
# needed here too since this process sends its own pushes directly, it doesn't call
# back into ookaro-api to do it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Standard 5-field cron expression. Default: every 15 minutes.
CART_ABANDONMENT_CRON=*/15 * * * *
# Payment-pending nudges: how often to look for unpaid online orders. The delays themselves
# (first reminder after 15 min, second after 3 hours) live in config_settings, editable in admin.
PAYMENT_NUDGES_CRON=*/5 * * * *
# Auto-cancel of unpaid online orders: how often to look. The hours (default 6) live in config_settings.
PAYMENT_AUTO_CANCEL_CRON=*/10 * * * *

# ookaro-api base URL the worker calls for scheduled broadcasts and the Razorpay webhook path.
# Local: http://localhost:3010 . Production: the VPS URL of ookaro-api (no trailing slash needed).
API_BASE_URL=
# Same shared secret ookaro-api's own .env.local holds (gates POST .../dispatch-due).
CRON_SECRET=
# Razorpay test/live keys - same as ookaro-api. Used to ask Razorpay what happened to a stuck payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same webhook secret configured in the Razorpay dashboard - used to sign the synthesized event.
RAZORPAY_WEBHOOK_SECRET=

# Job schedules (standard 5-field cron). Defaults shown.
SCHEDULED_BROADCASTS_CRON=* * * * *
OFFER_EXPIRY_CRON=* * * * *
STUCK_PAYMENTS_CRON=*/10 * * * *
AUTO_SETTLEMENTS_CRON=0 * * * *
